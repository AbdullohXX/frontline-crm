# Supabase Connect dialog. Use the publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact origin used for Google OAuth callbacks. No trailing slash.
APP_URL=http://localhost:3000
# Synthetic local preview only. Ignored in production, no live writes/auth bypass.
LOCAL_DEMO=false
# Server-only authentication for scheduled Quo sync.
CRON_SECRET=

# Quo integration: server only, never NEXT_PUBLIC_
QUO_API_KEY=
QUO_INGEST_TOKEN=
# Returned by the dated Quo webhook API (whsec_...)
QUO_WEBHOOK_KEY=
